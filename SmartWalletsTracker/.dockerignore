# Secrets — must never be baked into image
.env
*.pem
*.key
service-account*.json

# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs (if any local)
venv/
.venv/
env/

# macOS / editor junk
.DS_Store
.vscode/
.idea/

# Git
.git/
.gitignore

# Docs / design files (not needed at runtime)
*.md
DesignDoc.txt

# Code not used by the runtime pipeline
llm.py
check_swaps.py
infra/

# Docker itself
Dockerfile
.dockerignore
